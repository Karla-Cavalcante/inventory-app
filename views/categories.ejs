<!DOCTYPE html>
<html>
<head>
    <title>Categorias</title>
</head>
<body>
    <h1>Escolha uma Categoria</h1>
    <ul>
        <% categories.forEach(category => { %>
            <li>
                <a href="/category/<%= category.id %>"><%= category.name %></a>
            </li>
        <% }) %>
    </ul>
</body>
</html>
