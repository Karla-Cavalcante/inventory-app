<!DOCTYPE html>
<html>
<head>
    <title>Inventory Items</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body>
    <div class="container mt-4">
        <h1>Items in Inventory</h1>
        <a href="/items/new" class="btn btn-primary mb-3">Add New Item</a>

        <% if (items.length > 0) { %>
            <table class="table table-striped">
             <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Price</th>
                        <th>Quantity</th>
                        <th>Category</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% items.forEach(item => { %>
                        <tr>
                            <td><%= item.id %></td>
                            <td><%= item.name %></td>
                            <td><%= item.description %></td>
                            <td>$<%= item.price %></td>
                            <td><%= item.quantity %></td>
                            <td><%= item.category_id %></td>
                            <td>
                                <a href="/items/edit/<%= item.id %>" class="btn btn-warning btn-sm">Edit</a>
                                <form action="/items/delete/<%= item.id %>" method="POST" class="d-inline" 
                                      onsubmit="return confirm('Are you sure you want to delete this item?');">
                                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        <% } else { %>
            <p>No items found in the inventory.</p>
        <% } %>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
