<!DOCTYPE html>
<html>
<head>
    <title><%= item ? 'Edit Item' : 'Add New Item' %></title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body>
    <div class="container mt-4">
        <h1><%= item ? 'Edit Item' : 'Add New Item' %></h1>
        <form action="<%= item ? '/items/edit/' + item.id : '/items/new' %>" method="POST">
            <div class="mb-3">
                <label for="name" class="form-label">Item Name</label>
                <input type="text" name="name" class="form-control" id="name" 
                       value="<%= item ? item.name : '' %>" required>
            </div>

            <div class="mb-3">
                <label for="description" class="form-label">Description</label>
                <textarea name="description" class="form-control" id="description" rows="3" required>
                    <%= item ? item.description : '' %>
                </textarea>
            </div>

            <div class="mb-3">
                <label for="price" class="form-label">Price</label>
                <input type="number" step="0.01" name="price" class="form-control" id="price" 
                       value="<%= item ? item.price : '' %>" required>
            </div>

            <div class="mb-3">
                <label for="quantity" class="form-label">Quantity</label>
                <input type="number" name="quantity" class="form-control" id="quantity" 
                       value="<%= item ? item.quantity : '' %>" required>
            </div>

            <div class="mb-3">
                <label for="category_id" class="form-label">Category</label>
                <select name="category_id" class="form-select" id="category_id" required>
                    <option value="" disabled selected>Select Category</option>
                    <% categories.forEach(category => { %>
                        <option value="<%= category.id %>" 
                                <%= item && item.category_id === category.id ? 'selected' : '' %>>
                            <%= category.name %>
                        </option>
                    <% }) %>
                </select>
            </div>

            <button type="submit" class="btn btn-success">
                <%= item ? 'Update Item' : 'Create Item' %>
            </button>
            <a href="/items" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</body>
</html>
